{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)"
    ],
    "ask": [
      "Bash(npm install *jest@*)",
      "Bash(npm i *jest@*)",
      "Bash(bun add *jest@*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'npm test'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
